# Copy to .env. Only the LLM key is required for local development; the
# rest default to the docker-compose services.

# LLM provider. "deepseek" works out of the box with DEEPSEEK_API_KEY.
# Any OpenAI-compatible endpoint (vLLM, Ollama, a self-hosted model) works by
# setting LLM_PROVIDER=openai-compatible plus LLM_BASE_URL, LLM_MODEL and
# LLM_API_KEY.
DEEPSEEK_API_KEY=
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=

# DATABASE_URL=postgresql+psycopg://helios:helios@localhost:5433/helios
# S3_ENDPOINT_URL=http://localhost:9010
# S3_ACCESS_KEY=helios
# S3_SECRET_KEY=helios
# S3_BUCKET=helios-sources

# Shared secret the frontend sends as X-Gateway-Secret. Unset = no check
# (local development only).
# GATEWAY_SECRET=
