# Copy to .env. Required for local development: the import LLM key, the agent
# Azure Foundry settings, and EXA_API_KEY. Everything else defaults to the
# docker-compose services.

# Import / mapping LLM. "deepseek" works out of the box with DEEPSEEK_API_KEY.
# Any OpenAI-compatible endpoint (vLLM, Ollama, a self-hosted model) works by
# setting LLM_PROVIDER=openai-compatible plus LLM_BASE_URL, LLM_MODEL and
# LLM_API_KEY.
DEEPSEEK_API_KEY=
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=

# Agent chat LLM (default: Azure AI Foundry OpenAI-compatible endpoint).
# Auth uses the api-key header (Bearer also works on this host).
AGENT_LLM_PROVIDER=azure_foundry
AZURE_FOUNDRY_ENDPOINT=https://YOUR_RESOURCE.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_KEY=
AZURE_FOUNDRY_DEPLOYMENT_NAME=
# AGENT_LLM_BASE_URL=
# AGENT_LLM_MODEL=
# AGENT_LLM_API_KEY=

# Web research (Exa). Off for the agent until the user approves a second pass.
EXA_API_KEY=

# Prices for the cost on each model call's usage event, USD per 1M tokens
# (input, output). DeepSeek's own API is built in; set the Azure deployment's.
# TOKEN_PRICES={"DeepSeek-V4.1-Flash-1017": [0.28, 0.42]}

# Signs the export id inside exported workbooks (required; 32+ characters),
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
EXPORT_SECRET=

# DATABASE_URL=postgresql+psycopg://helios:helios@localhost:5433/helios
# S3_ENDPOINT_URL=http://localhost:9010
# S3_ACCESS_KEY=helios
# S3_SECRET_KEY=helios
# S3_BUCKET=helios-sources

# Shared secret the frontend sends as X-Gateway-Secret. Unset = no check
# (local development only).
# GATEWAY_SECRET=
